# ---------------------------------------------------------------------------
# Payment bridge connection
# ---------------------------------------------------------------------------
# Base URL of the bridge. Endpoints live under /api/bridge/v1 (or /bridge/v1).
BRIDGE_BASE_URL=https://www.jayamanicollections.com
BRIDGE_API_PREFIX=/api/bridge/v1
BRIDGE_TIMEOUT_MS=15000

# Optional extra header, only if your deployment protects the bridge.
# BRIDGE_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Public origin of THIS app. Used to build the default redirect_url
# ({PUBLIC_BASE_URL}/pay/{txn_id}) and the demo callback.
PUBLIC_BASE_URL=http://localhost:3000

# CORS origin allowed to call /api/* from a browser: "*", or your website.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Checkout behaviour
# ---------------------------------------------------------------------------
# Read the hosted checkout page (payment_url / custom_payment_url) and mine the
# real token + signed UPI intent out of it. Leave on unless the page is huge.
FETCH_PAYMENT_PAGE=1
PAGE_TIMEOUT_MS=8000

# auto = fall back to a clearly-labelled demo plan when the bridge cannot be
# reached (network / 5xx / missing gateway credentials). on | off also allowed.
DEMO_MODE=auto

# Default gateway when the client does not send one: phonepe | easebuzz
DEFAULT_PG_TYPE=phonepe

# Default amount (paise) for the "quick demo" button in the UI.
DEMO_AMOUNT_PAISE=49900

# ---------------------------------------------------------------------------
# Direct UPI app-launch buttons
# ---------------------------------------------------------------------------
# Your merchant UPI ID. When the gateway only returns an encrypted redirect
# token (no intent), the Pay button becomes a real UPI intent to this VPA so
# PhonePe / GPay / Paytm open straight on the phone. Leave blank to disable.
# Can also be set per request with {"upi_vpa": "..."}.
UPI_VPA=
UPI_PAYEE_NAME=
