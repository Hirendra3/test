{
  "name": "pg-bridge-pay",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript checkout for the multi-gateway Payment Bridge API (PhonePe V2 / Easebuzz) that recovers the genuine, signed UPI intent from the PhonePe payment_url token instead of trusting hand-built intent links.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "start": "node scripts/ensure-build.mjs && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.24.2",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
